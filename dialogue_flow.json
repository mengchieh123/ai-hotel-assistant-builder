{
    "flowName": "HotelBookingFlow",
    "version": "1.0",
    
    "states": {
        
        "init": {
            "prompt": "您好，歡迎使用訂房服務。請問您想預訂哪一天的房間？",
            "richCard": {
                "type": "quick_replies",
                "options": ["今天", "明天", "查看設施"]
            },
            "allowGeminiCall": false
        },
        
        "handle_general_inquiry": {
            "prompt": "這是 AI 助理的回覆。",
            "allowGeminiCall": true,
            "next_state": "paused_waiting_for_resume"
        },
        
        "paused_waiting_for_resume": {
            "prompt": "流程已暫停，請回覆「繼續」以返回訂房流程。",
            "richCard": {
                "type": "quick_replies",
                "options": ["繼續", "取消訂房"]
            },
            "allowGeminiCall": true
        },

        "ask_nights_and_dates": {
            "handler": "checkDateAndNights",
            "entities": [
                "checkInDate",
                "nights"
            ],
            "next_state": "ask_guest_count",
            "prompt": "請告訴我您的【入住日期】和【住宿晚數】。(例如：2026-03-01 兩晚)"
        },
        
        "ask_guest_count": {
            "handler": "checkDateAndNights",
            "entities": [
                "adultCount",
                "childCount"
            ],
            "next_state": "ask_room_count",
            "prompt": "請問入住的【大人】和【小孩】人數各是多少？"
        },

        "ask_room_count": {
            "entities": [
                "roomCount"
            ],
            "next_state": "show_room_types",
            "prompt": "請問您需要預訂【幾間】房間？"
        },
        
        "show_room_types": {
            "handler": "checkBookingEssentials",
            "entities": [
                "roomType"
            ],
            "next_state": "lock_inventory",
            "prompt": "請選擇您想要的房型：{CUSTOM_PROMPT} (例如：豪華客房)",
            "richCard": {
                "type": "carousel",
                "options": [
                    {"id": "StandardDouble", "title": "標準雙人房", "description": "TWD 3000"},
                    {"id": "DeluxeSuite", "title": "豪華套房", "description": "TWD 6000"},
                    {"id": "FamilyRoom", "title": "家庭四人房", "description": "TWD 4500"}
                ]
            }
        },

        "lock_inventory": {
            "handler": "lockInventory",
            "next_state": "check_availability_and_price",
            "prompt": "正在為您鎖定房型和價格...",
            "allowGeminiCall": false
        },

        "check_availability_and_price": {
            "handler": "calculatePrice",
            "next_state": "ask_addons",
            "prompt": "空房和價格檢查完成。{CUSTOM_PROMPT} 總金額為 **TWD {finalPrice} 元**。您想繼續加購服務嗎？",
            "richCard": {
                "type": "quick_replies",
                "options": ["查看加購服務", "跳過加購"]
            },
            "allowGeminiCall": false
        },
        
        "handle_member_login": {
            "handler": "loginMemberAccount", 
            "entities": [
                "memberAccount",
                "memberPassword"
            ],
            // 登入成功後，Handler 內部會導向 check_availability_and_price 重新計算價格
            "prompt": "請輸入您的【會員帳號】和【密碼】進行登入，我們將為您套用專屬折扣。",
            "allowGeminiCall": false
        },
        
        "ask_addons": {
            "handler": "generateAddonsCarousel",
            "intents": {
                "select_addon": "execute_addons_selection",
                "skip": "ask_contact_info"
            },
            "fallback": "您可以選擇加購服務或回覆「跳過」。",
            "prompt": "這是我們為您準備的加購服務清單，請問需要加選嗎？",
            "allowGeminiCall": true
        },

        "execute_addons_selection": {
            "handler": "executeAddonsSelection",
            "entities": [
                "addonSelection"
            ],
            "next_state": "check_availability_and_price",
            "prompt": "已記錄您的選擇，正在更新價格...",
            "allowGeminiCall": false
        },

        "ask_contact_info": {
            "handler": "validateContactInfo",
            "entities": [
                "contactName",
                "contactPhone",
                "contactEmail"
            ],
            "next_state": "ask_special_request",
            "prompt": "{CUSTOM_PROMPT} 請輸入【訂房人姓名】、【電話】和【電子郵件】。",
            "allowGeminiCall": false
        },

        "ask_special_request": {
            "handler": "handleSpecialRequests",
            "entities": [
                "specialRequest"
            ],
            "next_state": "ask_payment_method",
            "prompt": "請問您有什麼【特殊需求】嗎？(例如：高樓層、嬰兒床，若無請回覆「跳過」)",
            "allowGeminiCall": true
        },

        "ask_payment_method": {
            "entities": [
                "paymentMethod"
            ],
            "next_state": "confirm_booking",
            "prompt": "請選擇您的【付款方式】。",
            "richCard": {
                "type": "quick_replies",
                "options": ["信用卡", "銀行轉帳"]
            },
            "allowGeminiCall": false
        },

        "confirm_booking": {
            "handler": "generateOrderSummary",
            "prompt": "請確認您的訂單摘要，無誤後請回覆「確認」。",
            "allowGeminiCall": false
        },
        
        "booking_complete": {
            "prompt": "恭喜！您的訂單 **{orderId}** 已成功提交。{paymentMessage} 感謝您的預訂！",
            "richCard": {
                "type": "quick_replies",
                "options": ["再訂一次", "聯絡客服"]
            },
            "allowGeminiCall": false
        },
        
        "end_conversation": {
            "prompt": "謝謝您的使用，期待您的下次光臨。",
            "allowGeminiCall": false
        }
    }
}
