{
  "name": "HotelBookingFlow",
  "version": "1.8 (Finalized Logic)",
  "initial_state": "init",
  "states": {
    "init": {
      "prompt": "您好，我是您的專屬 AI 酒店訂房助理。很高興為您服務！請問您是想【預訂房間】還是【查詢酒店資訊】呢？",
      "richCard": {
        "type": "button_list",
        "title": "請選擇服務類型：",
        "buttons": [
          {
            "text": "🛏️ 預訂房間",
            "value": "我要訂房"
          },
          {
            "text": "ℹ️ 查詢資訊",
            "value": "我想查詢資訊"
          }
        ]
      },
      "intents": {
        "booking": "show_room_types",
        "general_inquiry": "handle_general_inquiry"
      },
      "fallback": "抱歉，我沒聽懂您的意思，請告訴我是想預訂房間或查詢其他資訊？"
    },
    "show_room_types": {
      "prompt": "我們有以下四種熱門房型：\n\n1. 標準雙人房 (定價NT$2,200)\n2. 豪華客房 (定價NT$3,200)\n3. 行政套房 (定價NT$4,800)\n4. 家庭四人房 (定價NT$4,500)\n\n請問您想預訂哪一種房型？",
      "richCard": {
        "type": "button_list",
        "title": "請選擇房型：",
        "buttons": [
          {
            "text": "標準雙人房",
            "value": "標準雙人房"
          },
          {
            "text": "豪華客房",
            "value": "豪華客房"
          },
          {
            "text": "行政套房",
            "value": "行政套房"
          },
          {
            "text": "家庭四人房",
            "value": "家庭四人房"
          }
        ]
      },
      "entities": ["roomType"],
      "next_state": "ask_room_count",
      "clear_entities": ["roomCount", "adultCount", "childCount", "checkInDate", "nights"],
      "fallback": "請告訴我您想預訂的房型名稱，例如：豪華客房。"
    },
    "ask_room_count": {
      "prompt": "好的，您選擇了 {roomType}。請問您需要預訂【幾間】呢？",
      "entities": ["roomCount"],
      "next_state": "ask_nights_and_dates",
      "fallback": "請提供您需要的房間間數，例如：2間。"
    },
    "ask_nights_and_dates": {
      "prompt": "請接著提供【入住日期】和【住宿晚數】 (例如：12月24日, 2晚)。",
      "entities": ["checkInDate", "nights"],
      "next_state": "ask_guest_count",
      "fallback": "請提供入住日期及住宿晚數，我會為您查詢空房與價格。"
    },
    "ask_guest_count": {
      "prompt": "感謝您！請問總共【幾位大人】和【幾位兒童】入住呢？ (例如：2位大人, 1位兒童)",
      "entities": ["adultCount", "childCount"],
      "next_state": "check_availability_and_price",
      "fallback": "請提供大人及兒童的人數。"
    },
    "check_availability_and_price": {
      "type": "logic_exec",
      "handler": "calculatePrice",
      "prompt": "已確認 {roomCount} 間 {roomType} 在 {checkInDate} 入住 {nights} 晚有空房。房費總價為 NT$ {totalPrice}。\n\n**您是否為會員？登入可享有額外折扣！**",
      "richCard": {
        "type": "button_list",
        "title": "會員獨享優惠：",
        "buttons": [
          {
            "text": "我是會員，我要登入",
            "value": "我要登入會員"
          },
          {
            "text": "我不是會員/暫不登入",
            "value": "我不是會員"
          }
        ]
      },
      "intents": {
        "member_login": "login_member_account",
        "deny": "ask_addons"
      },
      "fallback": "請回答您是否是會員，以便為您計算折扣。"
    },
    "login_member_account": {
      "prompt": "請輸入您的【會員帳號】或【手機號碼】。",
      "entities": ["memberAccount"],
      "next_state": "apply_member_discount",
      "fallback": "請輸入有效的會員帳號或手機號碼，以便我們查詢您的會員等級。"
    },
    "apply_member_discount": {
      "type": "logic_exec",
      "handler": "calculatePrice",
      "prompt": "✅ 登入成功！您是 **{memberLevel}** 會員，恭喜您享有額外折扣！原價 NT$ {totalBeforeDiscount}，折扣後總價為 NT$ {finalPrice}。現在將進入加購流程。",
      "entities": [],
      // ⭐️ 修正：直接導向 ask_addons (問題 4)
      "next_state": "ask_addons",
      "fallback": "資訊處理中，請稍候。"
    },
    // ⭐️ 移除 ask_transfer_service 狀態 (問題 4)
    "ask_addons": {
      "entities": ["addonId", "addonAction"],
      "handler": "executeAddonsSelection",
      // ⭐️ 修正：加購後進入聯絡資訊 (問題 4)
      "next_state": "ask_contact_info",
      "prompt": "請問您還需要加購其他服務或票券嗎？接送機服務已整合在下方選項中。請選擇。"
    },
    "ask_contact_info": {
      "prompt": "好的，請提供您的【訂房人姓名】、【聯絡電話】和【電子郵件】。這些資訊將用於訂單通知。",
      "entities": ["contactName", "contactPhone", "contactEmail"],
      // ⭐️ 新增 Handler：用於檢查輸入格式 (問題 6)
      "handler": "validateContactInfo",
      // ⭐️ 修正：聯絡資訊通過後進入付款方式選擇 (問題 5)
      "next_state": "ask_payment_method",
      "fallback": "請提供有效的訂房人姓名、聯絡電話和電子郵件，這是必填欄位。"
    },
    "ask_payment_method": {
      "type": "logic_exec",
      "handler": "calculatePrice",
      "prompt": "好的，所有加購服務和折扣已計入。您的最終總價為 **NT$ {finalPrice}**。請選擇您的付款方式：",
      "richCard": {
        "type": "button_list",
        "title": "請選擇付款方式：",
        "buttons": [
          {
            "text": "線上付款 (即時確認)",
            "value": "線上付款"
          },
          {
            "text": "現場結帳 (保留至入住)",
            "value": "現場結帳"
          }
        ]
      },
      "entities": ["paymentMethod"],
      "next_state": "confirm_booking",
      "fallback": "請選擇線上付款或現場結帳。"
    },
    "confirm_booking": {
      "type": "logic_exec",
      // ⭐️ 新增 Handler：在確認前顯示詳細摘要 (問題 7)
      "handler": "generateOrderSummary", 
      "prompt": "【最終確認】請檢視您的訂單：\n\n{finalSummary}\n\n若資料正確，請回覆『確認』；若要修改，請回覆『修改』。",
      "intents": {
        "affirm": "booking_complete",
        "correction": "select_correction_target"
      },
      "fallback": "請確認訂房資訊，並回答『確認』或『修改』。"
    },
    "select_correction_target": {
      "prompt": "請問您想修改哪個部分？",
      "richCard": {
        "type": "button_list",
        "title": "選擇修改項目：",
        "buttons": [
          {
            "text": "房型/間數/日期",
            "value": "修改房型"
          },
          {
          "text": "入住人數",
          "value": "修改人數"
          },
          {
            "text": "聯絡資訊",
            "value": "修改聯絡資訊"
          },
          {
            "text": "加購項目/付款方式",
            "value": "修改加購"
          }
        ]
      },
      "intents": {
        "modify_room_date": "show_room_types",
        "modify_guests": "ask_guest_count",
        "modify_contact": "ask_contact_info",
        "modify_addons": "ask_addons"
      },
      "fallback": "請選擇您想修改的項目。"
    },
    "booking_complete": {
      "type": "logic_exec",
      // ⭐️ 修正：在完成狀態執行最終提交和生成回覆 (問題 7)
      "handler": "submitBooking",
      "prompt": "{finalSummary}",
      "end": true
    },
    "end_conversation": {
      "prompt": "感謝您的使用，期待下次為您服務。",
      "end": true
    },
    "handle_general_inquiry": {
      "prompt": "請提供更多細節，我會盡力回答您。",
      "allow_gemini_call": true
    },
    "paused_waiting_for_resume": {
      "prompt": "流程已暫停，請回覆『繼續』或點擊按鈕恢復訂房。",
      "allow_gemini_call": true
    }
  }
}
