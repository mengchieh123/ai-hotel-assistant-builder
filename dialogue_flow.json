{
    "name": "HotelBookingFlow",
    "version": "1.19",
    "description": "流程穩定測試版 - V5.8 最終版：報價分離、容錯處理與 LLM 備援整合",
    "initial_state": "init",
    "states": {
        "init": {
            "prompt": "歡迎使用旅萌大酒店 AI 訂房助理！請問您想預訂哪一天的房間，以及住宿幾晚？ (例如：明天, 2晚)",
            "next_state": "ask_nights_and_dates",
            "clear_entities": [
                "roomType",
                "roomCount",
                "checkInDate",
                "nights",
                "memberAccount",
                "contactName",
                "contactPhone",
                "contactEmail",
                "specialRequest",
                "paymentMethod",
                "addonAction",
                "addonId",
                "isLoggedIn",
                "addons",
                "memberPassword",
                "inventoryLockId",
                "finalPrice",
                "priceDetails",
                "inventoryWarning",
                "llm_response",
                "llm_source"
            ],
            "entities": ["adultCount", "childCount", "roomCount"],
            "fallback": "您可以直接告訴我預計入住日期和晚數，例如：『我想訂明天兩晚的房間』。"
        },
        "ask_nights_and_dates": {
            "prompt": "請提供【入住日期】和【住宿晚數】 (例如：12月24日, 2晚)。",
            "entities": ["checkInDate", "nights"],
            "next_state": "check_date_completeness",
            "fallback": "請提供入住日期及住宿晚數，我會為您查詢空房與價格。"
        },
        "check_date_completeness": {
            "type": "logic_exec",
            "handler": "checkDateCompleteness",
            "next_state": "ask_guest_count",
            "fallback_state": "handle_date_not_found"
        },
        "handle_date_not_found": {
            "prompt": "抱歉，我需要明確的【入住日期】和【住宿晚數】才能繼續。請再試一次。 (例如：12月24日, 2晚)",
            "next_state": "ask_nights_and_dates",
            "fallback": "請重新輸入完整的日期和晚數。"
        },
        "ask_guest_count": {
            "prompt": "請提供【入住人數】 (大人/兒童數，例如：2大1小)，這會影響房型建議。",
            "entities": ["adultCount", "childCount"],
            "next_state": "show_room_types",
            "fallback": "請提供準確的入住人數 (大人/兒童)，謝謝。"
        },
        "show_room_types": {
            "prompt": "我們有以下四種熱門房型：\n\n- 標準雙人房 (NT$ 2,200/晚)\n- 豪華客房 (NT$ 3,200/晚)\n- 行政套房 (NT$ 4,800/晚)\n- 家庭四人房 (NT$ 4,500/晚)\n\n請問您想預訂哪一種房型？",
            "richCard": {
                "type": "button_list",
                "buttons": [
                    {"text": "標準雙人房", "value": "標準雙人房"},
                    {"text": "豪華客房", "value": "豪華客房"},
                    {"text": "行政套房", "value": "行政套房"},
                    {"text": "家庭四人房", "value": "家庭四人房"}
                ]
            },
            "entities": ["roomType"],
            "next_state": "ask_room_count",
            "fallback": "請告訴我您想預訂的房型名稱，例如：豪華客房。"
        },
        "ask_room_count": {
            "prompt": "好的，您選擇了 {roomType}。請問您需要預訂【幾間】呢？",
            "entities": ["roomCount"],
            "next_state": "check_essentials_before_price",
            "fallback": "請提供您需要的房間間數，例如：2間。"
        },
        "check_essentials_before_price": {
            "type": "logic_exec",
            "handler": "checkBookingEssentials",
            "next_state": "lock_inventory",
            "fallback_state": "init"
        },
        "lock_inventory": {
            "type": "logic_exec",
            "handler": "lockInventory",
            "prompt": "正在為您鎖定房型庫存，請稍候...",
            "next_state": "calculate_price_logic",
            "fallback": "房型鎖定失敗，請從頭開始。",
            "fallback_state": "ask_room_count",
            "allow_gemini_call": false
        },
        "calculate_price_logic": {
            "type": "logic_exec",
            "handler": "calculatePrice",
            "next_state": "ask_member_login",
            "fallback_state": "lock_inventory"
        },
        "ask_member_login": {
            "prompt": "已確認您的預訂資訊：{roomCount}間{roomType}，{nights}晚，入住日期{checkInDate}，總價為 **NT$ {finalPrice}**。\n\n您是否擁有旅萌大酒店的會員帳號？現在登入可享 5% 房費折扣。",
            "richCard": {
                "type": "button_list",
                "buttons": [
                    {"text": "我有會員，立即登入", "value": "登入會員", "intent": "login"},
                    {"text": "暫不登入，查看加購服務", "value": "查看加購服務", "intent": "skip"}
                ]
            },
            "intents": {
                "login": "login_member_account",
                "skip": "ask_addons"
            },
            "fallback": "請點擊按鈕或回覆『登入』或『跳過』。",
            "next_state": "ask_addons"
        },
        "login_member_account": {
            "type": "logic_exec",
            "handler": "loginMemberAccount",
            "prompt": "請輸入您的會員帳號 (手機號碼或 Email) 進行登入。",
            "entities": ["memberAccount"],
            "fallback": "請輸入有效的會員帳號，或回覆『跳過』。",
            "next_state": "ask_member_password",
            "intents": {
                "skip": "ask_addons"
            }
        },
        "ask_member_password": {
            "type": "logic_exec",
            "handler": "loginMemberAccount",
            "prompt": "請輸入您的會員密碼。",
            "entities": ["memberPassword"],
            "fallback": "請輸入有效的會員密碼，或回覆『跳過』。",
            "next_state": "calculate_price_logic",
            "intents": {
                "skip": "ask_addons"
            }
        },
        "ask_addons": {
            "type": "logic_exec",
            "handler": "generateAddonsCarousel",
            "prompt": "當前總價: **NT$ {finalPrice}**\n\n您可以選擇以下加購服務，或回覆『完成』進入下一步。 (已選購服務: {addons})",
            "entities": ["addonAction", "addonId"],
            "intents": {
                "affirm": "execute_addons_selection",
                "skip": "execute_addons_selection"
            },
            "fallback": "請選擇您需要的加購服務，或回覆『完成』。",
            "next_state": "execute_addons_selection"
        },
        "execute_addons_selection": {
            "type": "logic_exec",
            "handler": "executeAddonsSelection",
            "next_state": "ask_contact_info",
            "fallback_state": "ask_addons"
        },
        "ask_contact_info": {
            "type": "logic_exec",
            "handler": "validateContactInfo",
            "prompt": "當前總價: **NT$ {finalPrice}**\n\n請提供【聯絡人姓名】、【手機號碼】和【電子郵件】 (例如：王大明, 0912345678, test@mail.com)。",
            "entities": ["contactName", "contactPhone", "contactEmail"],
            "next_state": "ask_special_requests",
            "fallback": "請務必提供有效的聯絡資訊，這關係到您的訂單接收。"
        },
        "ask_special_requests": {
            "type": "logic_exec",
            "handler": "handleSpecialRequests",
            "prompt": "當前總價: **NT$ {finalPrice}**\n\n請問您有任何特殊需求嗎？ (例如：高樓層、素食早餐、嬰兒床等)\n\n若無，請回覆『無』。",
            "entities": ["specialRequest"],
            "next_state": "ask_payment_method",
            "fallback": "請提供特殊要求或回覆『無』。"
        },
        "ask_payment_method": {
            "type": "logic_exec",
            "handler": "calculatePrice",
            "prompt": "最終總價為 **NT$ {finalPrice}**。請選擇您的付款方式：",
            "richCard": {
                "type": "button_list",
                "buttons": [
                    {"text": "信用卡 (VISA/Master)", "value": "信用卡"},
                    {"text": "LINE Pay", "value": "LINE Pay"},
                    {"text": "現場支付", "value": "現場支付"}
                ]
            },
            "entities": ["paymentMethod"],
            "next_state": "confirm_booking",
            "fallback": "請選擇一種付款方式。"
        },
        "confirm_booking": {
            "type": "logic_exec",
            "handler": "generateOrderSummary",
            "prompt": "請確認您的訂單摘要：\n{finalSummary}\n\n最終總價: **NT$ {finalPrice}**\n\n是否確認送出訂單？",
            "richCard": {
                "type": "button_list",
                "buttons": [
                    {"text": "確認送出", "value": "確認送出", "intent": "affirm"},
                    {"text": "修改資訊", "value": "修改資訊", "intent": "correction"}
                ]
            },
            "intents": {
                "affirm": "booking_complete",
                "correction": "select_correction_target"
            },
            "fallback": "請回覆『確認送出』或『修改資訊』。",
            "next_state": "select_correction_target"
        },
        "select_correction_target": {
            "prompt": "請問您想修改哪部分資訊？",
            "richCard": {
                "type": "button_list",
                "buttons": [
                    {"text": "修改日期/晚數", "value": "修改日期"},
                    {"text": "修改房型/間數", "value": "修改房型"},
                    {"text": "修改加購服務", "value": "修改加購"},
                    {"text": "修改聯絡資訊", "value": "修改聯絡"}
                ]
            },
            "intents": {
                "correction_date": "ask_nights_and_dates",
                "correction_room": "show_room_types",
                "correction_addons": "ask_addons",
                "correction_contact": "ask_contact_info"
            },
            "fallback": "請選擇您要修改的目標。",
            "next_state": "confirm_booking"
        },
        "booking_complete": {
            "type": "logic_exec",
            "handler": "submitBooking",
            "prompt": "🎉 訂房完成！您的訂單號為 **{orderId}**。最終總價: **NT$ {finalPrice}**。{paymentMessage}",
            "end": true,
            "fallback": "訂單已送出，無法修改。"
        },
        "end_conversation": {
            "prompt": "謝謝您的預訂！期待您的光臨。您可以輸入『重新開始』或『查詢訂單』。",
            "intents": {
                "booking": "init"
            },
            "fallback": "謝謝，祝您有美好的一天！",
            "next_state": "init"
        },
        
        // =================================================================
        // 🚀 LLM 備援流程狀態 (新增/修改)
        // =================================================================
        
        "handle_general_inquiry": {
            "type": "logic_exec",
            "prompt": "正在為您查詢通用資訊，請稍候...", 
            "handler": "processGeneralInquiry", 
            "next_state": "general_inquiry_response", // 成功：跳轉到回應展示
            "fallback_state": "handle_llm_failure" // 失敗：跳轉到容錯提示
        },

        "general_inquiry_response": {
            "prompt": "🤖 這是來自 **{llm_source}** 的回應：\n\n{llm_response}\n\n請問您是否要回到之前的訂房流程？",
            "richCard": {
                "type": "button_list",
                "buttons": [
                    {"text": "繼續訂房", "value": "繼續", "intent": "affirm"},
                    {"text": "重新預訂", "value": "重新預訂", "intent": "booking"}
                ]
            },
            "intents": {
                "affirm": "paused_waiting_for_resume", 
                "booking": "init",
                "reset": "init"
            },
            "fallback": "請回覆『繼續』以恢復訂房，或輸入『重新開始』。"
        },
        
        "handle_llm_failure": {
            "prompt": "抱歉，目前所有通用資訊服務都連線失敗，無法回答您的問題。\n\n請問您現在需要：",
            "richCard": {
                "type": "button_list",
                "buttons": [
                    {"text": "返回主流程", "value": "繼續訂房", "intent": "affirm"},
                    {"text": "重新預訂", "value": "重新預訂", "intent": "booking"}
                ]
            },
            "next_state": "paused_waiting_for_resume", // 暫存狀態，讓 Rule Engine 的 P:99 規則決定恢復到哪一步
            "fallback": "請回覆『繼續』或『重新開始』。"
        },
        
        "paused_waiting_for_resume": {
            "prompt": "流程已暫停。請回覆『繼續』或點擊按鈕恢復訂房流程，或提出新的預訂請求。",
            "richCard": {
                "type": "button_list",
                "buttons": [
                    {"text": "繼續訂房", "value": "繼續", "intent": "affirm"},
                    {"text": "重新預訂", "value": "重新預訂", "intent": "booking"}
                ]
            },
            "intents": {
                "affirm": "", // 讓 Rule Engine 的 P:99 規則執行
                "booking": "init",
                "correction": "select_correction_target"
            },
            "fallback": "抱歉，無法恢復流程。請重新輸入『繼續』或『重新預訂』。",
            "next_state": "init"
        }
        
    }
}
