{
  "name": "ai-hotel-assistant",
  "version": "5.6.0",
  "description": "AI Hotel Assistant Service with Modular Business Logic and Attractions - Full Stack Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "keep-alive": "node keep-alive.js",
    "frontend": "npx serve . -s -l 8080",
    "frontend:dev": "npx live-server . --port=3000 --entry-file=working-chat.html",
    "build:frontend": "echo 'Frontend is static HTML, no build required'",
    "deploy:fullstack": "npm start",
    "test": "node test-health.js",
    "test:api": "node test-api.js",
    "test:frontend": "echo 'Open http://localhost:8080/working-chat.html to test frontend'",
    "test:gemini": "node test-gemini.js"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "chrono-node": "^2.9.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "AI Hotel Assistant Team",
  "license": "MIT",
  "keywords": [
    "hotel",
    "booking",
    "ai",
    "assistant",
    "chatbot",
    "travel",
    "reservation",
    "frontend",
    "fullstack"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mengchieh123/ai-hotel-assistant-builder"
  },
  "homepage": "https://ai-hotel-assistant-builder-production.up.railway.app"
}
