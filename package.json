{
  "name": "ai-hotel-assistant",
  "version": "5.7.0",
  "description": "AI Hotel Assistant with MCP Support - Full Stack Application",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "preinstall": "npm config set legacy-peer-deps true",
    "start": "NODE_PATH=./node_modules node server.js",  
    "dev": "nodemon server.js",
    "dev:mcp": "nodemon mcp-server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:mcp\"",
    "mcp": "node mcp-server.js",
    "worker": "node worker.js",
    "test": "node test-mcp-client.js",
    "test:server": "node test-server.js",
    "build": "echo 'Building AI Hotel Assistant...'",
    "deploy": "npm run build && npm start",
    "health": "curl -f http://localhost:3000/health || exit 1",
    "lint": "echo 'Linting not configured'",
    "format": "prettier --write '**/*.{js,json,md}'",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "@google/genai": "^0.15.0",
    "axios": "^1.6.8",
    "body-parser": "^1.20.2",
    "chrono-node": "^2.9.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": "AI Hotel Assistant Team",
  "license": "MIT",
  "keywords": [
    "hotel",
    "booking",
    "ai",
    "assistant",
    "chatbot",
    "mcp",
    "render",
    "travel",
    "reservation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mengchieh123/ai-hotel-assistant-builder"
  },
  "homepage": "https://ai-hotel-assistant-builder.onrender.com",
  "bugs": {
    "url": "https://github.com/mengchieh123/ai-hotel-assistant-builder/issues"
  }
}
